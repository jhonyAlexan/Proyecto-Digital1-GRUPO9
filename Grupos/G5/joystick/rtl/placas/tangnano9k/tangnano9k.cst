// Pines de la prueba del mando en la Sipeed Tang Nano 9K.
// Reloj, S1 y LEDs: los mismos del laboratorio FemtoRV (ejemplos oficiales de Sipeed).
// UART con la ESP32: pines 28 y 29 del banco 2, que trabaja a 3,3 V, igual que la ESP32.

// Reloj de 27 MHz
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Botón S1 (reset), 0 al presionar
IO_LOC "btn_s1" 4;
IO_PORT "btn_s1" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// LEDs de la tarjeta (activos en bajo)
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// UART con la ESP32. PULL_MODE=UP en la entrada: si el cable se suelta, la línea queda en reposo (1)
IO_LOC "uart_rx" 28;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" 29;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
