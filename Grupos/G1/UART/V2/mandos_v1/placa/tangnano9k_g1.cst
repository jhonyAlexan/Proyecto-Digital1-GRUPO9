// tangnano9k_g1.cst - Tang Nano 9K (GW1NR-LV9QN88PC6/I5) para top_prueba_tangnano9k.v
// Pines elegidos para no chocar con:
//   SoC:  17/18 (UART del PC), 3/4 (botones), 10-16 (LEDs)
//   G3:   25-29 (IMU por SPI y golpe_out)
//   G5:   28/29 (su montaje de joystick)  -> por acordar si se unifica

// Reloj de 27 MHz
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Boton S1 (reset), banco de 1,8 V como en el SoC y en G3
IO_LOC  "btn_rst_n" 4;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// UART desde la ESP32 de la consola (GPIO17). GND comun.
IO_LOC  "uart_rx_mando" 33;
IO_PORT "uart_rx_mando" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs de la placa (activos en bajo), banco de 1,8 V como en el SoC
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
