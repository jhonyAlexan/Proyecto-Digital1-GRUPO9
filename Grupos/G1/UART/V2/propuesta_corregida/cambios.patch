+    localparam R_IDLE = 3'd0, R_START = 3'd1, R_DATA = 3'd2, R_STOP = 3'd3,
+               R_ESPERA = 3'd4;
 
     reg [1:0]    rx_sync;
-    reg [1:0]    r_state;
+    reg [2:0]    r_state;
     reg [CW-1:0] r_cnt;
     reg [2:0]    r_idx;
     reg [7:0]    r_sh;
@@ -138,13 +140,18 @@ module uart_8n1 #(
                 R_STOP: begin
                     if (r_cnt == CPB-1) begin
                         r_cnt   <= 0;
-                        r_state <= R_IDLE;
                         if (rx_in) begin
                             rx_data  <= r_sh;
                             rx_valid <= 1'b1;
-                        end else rx_frame_err <= 1'b1;
+                            r_state  <= R_IDLE;
+                        end else begin
+                            rx_frame_err <= 1'b1;
+                            r_state      <= R_ESPERA;   // línea en 0: no leer basura
+                        end
                     end else r_cnt <= r_cnt + 1'b1;
                 end
+                R_ESPERA: if (rx_in) r_state <= R_IDLE;
+                default:  r_state <= R_IDLE;
             endcase
         end
     end
