diff --git a/projecto/consola/rtl/mandos/desempaquetador.v b/projecto/consola/rtl/mandos/desempaquetador.v
new file mode 100644
index 0000000..288aa7f
--- /dev/null
+++ b/projecto/consola/rtl/mandos/desempaquetador.v
@@ -0,0 +1,136 @@
+// -----------------------------------------------------------------------------
+// DESEMPAQUETADOR (lado receptor, consola) — autor original: Cesar Jaramillo (G1)
+// Versión adaptada a la trama acordada con G5 / G6 / G2 (8 bytes):
+//
+//   byte 0  CABECERA   0xAA
+//   byte 1  jugador    1 o 2
+//   byte 2  secuencia  0..255 (sube en cada trama)
+//   byte 3  X          con signo, -127..127
+//   byte 4  Y          con signo, -127..127
+//   byte 5  shield     bit 0 (botón del joystick)  -> registro bit 16
+//   byte 6  punch      bit 0 (ataque / golpe)      -> registro bit 17
+//   byte 7  checksum   XOR de los bytes 1..6
+//
+// FSM (misma idea del diagrama Package_Manager, ahora por posición):
+//   S_DIR : espera la cabecera 0xAA (cualquier otro byte se ignora).
+//   S_VAL : guarda los bytes 1..6 en latches mientras acumula el XOR.
+//   S_CHK : compara el checksum. Si es correcto y el jugador es 1 o 2,
+//           copia TODA la muestra de ese jugador en un solo flanco.
+//
+// Errores (pulsos de 1 ciclo):
+//   dir_err : trama completa con checksum bien pero jugador distinto de 1 y 2
+//   val_err : checksum incorrecto (la muestra se descarta)
+// Resincronización: si llega rx_frame_err o pasan T_MAX_CICLOS sin bytes con
+// una trama a medias, se descarta y se vuelve a S_DIR.
+//
+// Los registros de salida solo se limpian con el reset global.
+// -----------------------------------------------------------------------------
+module desempaquetador #(
+    parameter [7:0]  CABECERA     = 8'hAA,
+    parameter [7:0]  JUG_P1       = 8'd1,
+    parameter [7:0]  JUG_P2       = 8'd2,
+    parameter integer T_MAX_CICLOS = 27_000          // 1 ms a 27 MHz
+)(
+    input  wire       clk,
+    input  wire       rst_n,
+    // Desde la UART
+    input  wire [7:0] rx_data,
+    input  wire       rx_valid,
+    input  wire       rx_frame_err,
+    // Última muestra válida de cada jugador
+    output reg  [7:0] p1_x,
+    output reg  [7:0] p1_y,
+    output reg        p1_punch,
+    output reg        p1_shield,
+    output reg  [7:0] p1_seq,
+    output reg  [7:0] p2_x,
+    output reg  [7:0] p2_y,
+    output reg        p2_punch,
+    output reg        p2_shield,
+    output reg  [7:0] p2_seq,
+    // Pulsos de 1 ciclo
+    output reg        p1_nuevo,     // llegó una trama válida del jugador 1
+    output reg        p2_nuevo,     // llegó una trama válida del jugador 2
+    output reg        dir_err,
+    output reg        val_err
+);
+    localparam [1:0] S_DIR = 2'd0, S_VAL = 2'd1, S_CHK = 2'd2;
+    localparam integer TW = $clog2(T_MAX_CICLOS + 1);
+
+    reg [1:0]    state;
+    reg [2:0]    idx;                       // byte esperado dentro de S_VAL (1..6)
+    reg [7:0]    jug_l, seq_l, x_l, y_l;    // latches de la trama en curso
+    reg          shield_l, punch_l;
+    reg [7:0]    xor_l;
+    reg [TW-1:0] espera;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state    <= S_DIR;
+            idx      <= 3'd0;
+            jug_l    <= 8'd0;  seq_l <= 8'd0;  x_l <= 8'd0;  y_l <= 8'd0;
+            shield_l <= 1'b0;  punch_l <= 1'b0;
+            xor_l    <= 8'd0;
+            espera   <= 0;
+            p1_x <= 8'd0; p1_y <= 8'd0; p1_punch <= 1'b0; p1_shield <= 1'b0; p1_seq <= 8'd0;
+            p2_x <= 8'd0; p2_y <= 8'd0; p2_punch <= 1'b0; p2_shield <= 1'b0; p2_seq <= 8'd0;
+            p1_nuevo <= 1'b0;  p2_nuevo <= 1'b0;
+            dir_err  <= 1'b0;  val_err  <= 1'b0;
+        end else begin
+            p1_nuevo <= 1'b0;  p2_nuevo <= 1'b0;
+            dir_err  <= 1'b0;  val_err  <= 1'b0;
+
+            if (rx_frame_err) begin                 // byte corrupto: descartar trama
+                state  <= S_DIR;
+                espera <= 0;
+            end else if (rx_valid) begin
+                espera <= 0;
+                case (state)
+                    S_DIR: if (rx_data == CABECERA) begin
+                        idx   <= 3'd1;
+                        xor_l <= 8'd0;
+                        state <= S_VAL;
+                    end
+
+                    S_VAL: begin
+                        xor_l <= xor_l ^ rx_data;
+                        case (idx)
+                            3'd1:    jug_l    <= rx_data;
+                            3'd2:    seq_l    <= rx_data;
+                            3'd3:    x_l      <= rx_data;
+                            3'd4:    y_l      <= rx_data;
+                            3'd5:    shield_l <= rx_data[0];
+                            default: punch_l  <= rx_data[0];
+                        endcase
+                        if (idx == 3'd6) state <= S_CHK;
+                        else             idx   <= idx + 1'b1;
+                    end
+
+                    S_CHK: begin
+                        state <= S_DIR;
+                        if (rx_data != xor_l) begin
+                            val_err <= 1'b1;        // checksum malo: se conserva lo anterior
+                        end else if (jug_l == JUG_P1) begin
+                            p1_x <= x_l; p1_y <= y_l; p1_shield <= shield_l;
+                            p1_punch <= punch_l; p1_seq <= seq_l;
+                            p1_nuevo <= 1'b1;
+                        end else if (jug_l == JUG_P2) begin
+                            p2_x <= x_l; p2_y <= y_l; p2_shield <= shield_l;
+                            p2_punch <= punch_l; p2_seq <= seq_l;
+                            p2_nuevo <= 1'b1;
+                        end else begin
+                            dir_err <= 1'b1;        // jugador que no existe
+                        end
+                    end
+
+                    default: state <= S_DIR;
+                endcase
+            end else if (state != S_DIR) begin      // plazo entre bytes
+                if (espera == T_MAX_CICLOS - 1) begin
+                    state  <= S_DIR;
+                    espera <= 0;
+                end else espera <= espera + 1'b1;
+            end
+        end
+    end
+endmodule
diff --git a/projecto/consola/rtl/mandos/uart_8n1.v b/projecto/consola/rtl/mandos/uart_8n1.v
new file mode 100644
index 0000000..3bb4fb9
--- /dev/null
+++ b/projecto/consola/rtl/mandos/uart_8n1.v
@@ -0,0 +1,158 @@
+// -----------------------------------------------------------------------------
+// UART 8N1 (TX + RX).  Tang Nano 9K: CLK_HZ = 27_000_000, BAUD = 115_200
+// Se llama uart_8n1 para no chocar con el módulo "uart" de rtl/uart/uart.v
+//
+// TX: poner tx_data y pulsar tx_start (1 ciclo) cuando tx_busy = 0.
+//     tx_busy sube en el mismo ciclo en que tx_start vale 1.
+// RX: rx_valid es un pulso de 1 ciclo con rx_data listo.
+//     Si el stop bit no es 1 no hay rx_valid: se levanta rx_frame_err y se
+//     espera a que la línea vuelva a 1 antes de buscar otro start (R_ESPERA).
+// -----------------------------------------------------------------------------
+module uart_8n1 #(
+    parameter CLK_HZ = 27_000_000,
+    parameter BAUD   = 115_200
+)(
+    input  wire       clk,
+    input  wire       rst_n,
+    // TX
+    input  wire [7:0] tx_data,
+    input  wire       tx_start,
+    output reg        tx,
+    output wire       tx_busy,
+    // RX
+    input  wire       rx,
+    output reg  [7:0] rx_data,
+    output reg        rx_valid,
+    output reg        rx_frame_err
+);
+    localparam integer CPB  = CLK_HZ / BAUD;      // 234 ciclos por bit
+    localparam integer HALF = CPB / 2;
+    localparam integer CW   = $clog2(CPB) + 1;
+
+    // ------------------------------- TX --------------------------------------
+    localparam T_IDLE = 2'd0, T_START = 2'd1, T_DATA = 2'd2, T_STOP = 2'd3;
+
+    reg [1:0]    t_state;
+    reg [CW-1:0] t_cnt;
+    reg [2:0]    t_idx;
+    reg [7:0]    t_sh;
+
+    assign tx_busy = (t_state != T_IDLE) | tx_start;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            t_state <= T_IDLE;
+            t_cnt   <= 0;
+            t_idx   <= 3'd0;
+            t_sh    <= 8'd0;
+            tx      <= 1'b1;
+        end else begin
+            case (t_state)
+                T_IDLE: begin
+                    tx    <= 1'b1;
+                    t_cnt <= 0;
+                    t_idx <= 3'd0;
+                    if (tx_start) begin
+                        t_sh    <= tx_data;
+                        tx      <= 1'b0;                 // start bit
+                        t_state <= T_START;
+                    end
+                end
+                T_START: begin
+                    if (t_cnt == CPB-1) begin
+                        t_cnt   <= 0;
+                        tx      <= t_sh[0];              // bit 0 (LSB primero)
+                        t_state <= T_DATA;
+                    end else t_cnt <= t_cnt + 1'b1;
+                end
+                T_DATA: begin
+                    if (t_cnt == CPB-1) begin
+                        t_cnt <= 0;
+                        if (t_idx == 3'd7) begin
+                            tx      <= 1'b1;             // stop bit
+                            t_state <= T_STOP;
+                        end else begin
+                            t_idx <= t_idx + 1'b1;
+                            t_sh  <= {1'b0, t_sh[7:1]};
+                            tx    <= t_sh[1];
+                        end
+                    end else t_cnt <= t_cnt + 1'b1;
+                end
+                T_STOP: begin
+                    if (t_cnt == CPB-1) begin
+                        t_cnt   <= 0;
+                        t_state <= T_IDLE;
+                    end else t_cnt <= t_cnt + 1'b1;
+                end
+            endcase
+        end
+    end
+
+    // ------------------------------- RX --------------------------------------
+    localparam R_IDLE = 3'd0, R_START = 3'd1, R_DATA = 3'd2, R_STOP = 3'd3,
+               R_ESPERA = 3'd4;
+
+    reg [1:0]    rx_sync;
+    reg [2:0]    r_state;
+    reg [CW-1:0] r_cnt;
+    reg [2:0]    r_idx;
+    reg [7:0]    r_sh;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) rx_sync <= 2'b11;
+        else        rx_sync <= {rx_sync[0], rx};
+    end
+    wire rx_in = rx_sync[1];
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            r_state      <= R_IDLE;
+            r_cnt        <= 0;
+            r_idx        <= 3'd0;
+            r_sh         <= 8'd0;
+            rx_data      <= 8'd0;
+            rx_valid     <= 1'b0;
+            rx_frame_err <= 1'b0;
+        end else begin
+            rx_valid     <= 1'b0;
+            rx_frame_err <= 1'b0;
+
+            case (r_state)
+                R_IDLE: begin
+                    r_cnt <= 0;
+                    r_idx <= 3'd0;
+                    if (!rx_in) r_state <= R_START;
+                end
+                R_START: begin                           // verificar start a mitad de bit
+                    if (r_cnt == HALF-1) begin
+                        r_cnt <= 0;
+                        r_state <= rx_in ? R_IDLE : R_DATA;
+                    end else r_cnt <= r_cnt + 1'b1;
+                end
+                R_DATA: begin
+                    if (r_cnt == CPB-1) begin
+                        r_cnt <= 0;
+                        r_sh  <= {rx_in, r_sh[7:1]};     // LSB primero
+                        if (r_idx == 3'd7) r_state <= R_STOP;
+                        else               r_idx   <= r_idx + 1'b1;
+                    end else r_cnt <= r_cnt + 1'b1;
+                end
+                R_STOP: begin
+                    if (r_cnt == CPB-1) begin
+                        r_cnt   <= 0;
+                        if (rx_in) begin
+                            rx_data  <= r_sh;
+                            rx_valid <= 1'b1;
+                            r_state  <= R_IDLE;
+                        end else begin
+                            rx_frame_err <= 1'b1;
+                            r_state      <= R_ESPERA;   // línea en 0: no leer basura
+                        end
+                    end else r_cnt <= r_cnt + 1'b1;
+                end
+                R_ESPERA: if (rx_in) r_state <= R_IDLE;
+                default:  r_state <= R_IDLE;
+            endcase
+        end
+    end
+endmodule
diff --git a/projecto/consola/rtl/perip_mandos.v b/projecto/consola/rtl/perip_mandos.v
new file mode 100644
index 0000000..f3a159e
--- /dev/null
+++ b/projecto/consola/rtl/perip_mandos.v
@@ -0,0 +1,95 @@
+// -----------------------------------------------------------------------------
+// perip_mandos.v — Periférico de mandos para el SoC de la consola (G1)
+// Usa uart_8n1 + desempaquetador (Cesar Jaramillo) y presenta los registros
+// que espera el juego del G6 (firmware/hardware.h) y que documenta el G5.
+//
+// Región del SoC: 0x0047_xxxx  (chip_select.v, cs[7])
+//   +0x0  JOY1_DATA  [7:0] X  [15:8] Y  [16] shield (botón)  [17] punch (ataque)
+//                    [23:18] 0  [31:24] secuencia
+//   +0x4  JOY2_DATA  igual para el jugador 2
+//   +0x8  STATUS     [0] P1_VALID  [1] P2_VALID  [2] UART_ERROR  [3] CHECKSUM_ERROR
+//   otros 0
+// Las banderas de STATUS quedan en 1 hasta el reset (contrato del G5).
+//
+// Bus igual al de peripheral_mult / peripheral_uart del SoC:
+//   clk, reset (alto), d_in, cs, addr[31:0] (solo addr[3:0]), rd, wr, d_out
+//   d_out se captura en el flanco siguiente a cs & rd (misma latencia que mult).
+// Registros de solo lectura: wr y d_in no se usan.
+// -----------------------------------------------------------------------------
+module peripheral_mandos #(
+    parameter integer CLK_HZ = 27_000_000,
+    parameter integer BAUD   = 115_200
+) (
+    input  wire        clk,
+    input  wire        reset,
+    input  wire [31:0] d_in,
+    input  wire        cs,
+    input  wire [31:0] addr,
+    input  wire        rd,
+    input  wire        wr,
+    output reg  [31:0] d_out,
+    // Línea física: TX de la ESP32 de la consola
+    input  wire        uart_rx,
+    // Para LEDs o depuración (opcional)
+    output wire [31:0] joy1_data,
+    output wire [31:0] joy2_data,
+    output wire [3:0]  status
+);
+    wire rst_n = ~reset;
+
+    // ---------------- UART (solo RX) ----------------
+    wire [7:0] rx_data;
+    wire       rx_valid, rx_frame_err;
+
+    uart_8n1 #(.CLK_HZ(CLK_HZ), .BAUD(BAUD)) u_uart (
+        .clk(clk), .rst_n(rst_n),
+        .tx_data(8'd0), .tx_start(1'b0), .tx(), .tx_busy(),
+        .rx(uart_rx), .rx_data(rx_data), .rx_valid(rx_valid),
+        .rx_frame_err(rx_frame_err));
+
+    // ---------------- Desempaquetador ----------------
+    wire [7:0] p1_x, p1_y, p1_seq, p2_x, p2_y, p2_seq;
+    wire       p1_punch, p1_shield, p2_punch, p2_shield;
+    wire       p1_nuevo, p2_nuevo, dir_err, val_err;
+
+    desempaquetador #(.T_MAX_CICLOS(CLK_HZ / 1000)) des (
+        .clk(clk), .rst_n(rst_n),
+        .rx_data(rx_data), .rx_valid(rx_valid), .rx_frame_err(rx_frame_err),
+        .p1_x(p1_x), .p1_y(p1_y), .p1_punch(p1_punch), .p1_shield(p1_shield), .p1_seq(p1_seq),
+        .p2_x(p2_x), .p2_y(p2_y), .p2_punch(p2_punch), .p2_shield(p2_shield), .p2_seq(p2_seq),
+        .p1_nuevo(p1_nuevo), .p2_nuevo(p2_nuevo),
+        .dir_err(dir_err), .val_err(val_err));
+
+    // ---------------- STATUS ----------------
+    reg p1_valid, p2_valid, uart_error, chk_error;
+    always @(posedge clk) begin
+        if (reset) begin
+            p1_valid <= 1'b0;  p2_valid  <= 1'b0;
+            uart_error <= 1'b0; chk_error <= 1'b0;
+        end else begin
+            if (p1_nuevo)     p1_valid   <= 1'b1;
+            if (p2_nuevo)     p2_valid   <= 1'b1;
+            if (rx_frame_err) uart_error <= 1'b1;
+            if (val_err)      chk_error  <= 1'b1;
+        end
+    end
+
+    assign joy1_data = {p1_seq, 6'd0, p1_punch, p1_shield, p1_y, p1_x};
+    assign joy2_data = {p2_seq, 6'd0, p2_punch, p2_shield, p2_y, p2_x};
+    assign status    = {chk_error, uart_error, p2_valid, p1_valid};
+
+    // ---------------- Lectura desde el procesador ----------------
+    always @(posedge clk) begin
+        if (reset) d_out <= 32'd0;
+        else if (cs && rd) begin
+            case (addr[3:0])
+                4'h0:    d_out <= joy1_data;
+                4'h4:    d_out <= joy2_data;
+                4'h8:    d_out <= {28'd0, status};
+                default: d_out <= 32'd0;
+            endcase
+        end
+    end
+
+    wire _sin_uso = &{1'b0, wr, d_in, addr[31:4]};
+endmodule
diff --git a/projecto/consola/sim/mandos_prueba.hex b/projecto/consola/sim/mandos_prueba.hex
new file mode 100644
index 0000000..58322b4
--- /dev/null
+++ b/projecto/consola/sim/mandos_prueba.hex
@@ -0,0 +1,9 @@
+// Programa de prueba (RV32I a mano) para tb_soc_mandos.v
+004700b7  // 0x000: lui  x1, 0x00470      # x1 = 0x0047_0000 (MANDOS_BASE)
+0000a103  // 0x004: lw   x2, 0(x1)         # JOY1_DATA
+0040a183  // 0x008: lw   x3, 4(x1)         # JOY2_DATA
+0080a203  // 0x00c: lw   x4, 8(x1)         # STATUS
+40202023  // 0x010: sw   x2, 0x400(x0)     # RAM[0x400] = JOY1
+40302223  // 0x014: sw   x3, 0x404(x0)     # RAM[0x404] = JOY2
+40402423  // 0x018: sw   x4, 0x408(x0)     # RAM[0x408] = STATUS
+fe9ff06f  // 0x01c: jal  x0, -24           # volver a 0x004
