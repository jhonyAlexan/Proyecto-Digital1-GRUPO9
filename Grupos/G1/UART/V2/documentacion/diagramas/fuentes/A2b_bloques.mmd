flowchart LR
  classDef dp fill:#eef3fb,stroke:#1f5fbf
  classDef bus fill:#fff4d6,stroke:#b26b00
  rx(["uart_rx (1)"]):::bus --> U
  subgraph P["peripheral_mandos"]
    direction LR
    U["<b>uart_8n1 (RX)</b><br/>sincronizador 2 FF<br/>FSM + r_cnt + r_idx + r_sh"]:::dp
    D["<b>desempaquetador</b><br/>FSM S_DIR/S_VAL/S_CHK<br/>latches, XOR, plazo 1 ms<br/>registros p1_*, p2_*"]:::dp
    S["<b>STATUS</b><br/>4 banderas retenidas"]:::dp
    J["<b>armado de palabras</b><br/>JOY1 = {seq, 6'b0, punch, shield, Y, X}<br/>JOY2 = igual J2"]:::dp
    DEC["<b>decodificador local</b><br/>addr[3:0]: 0x0 / 0x4 / 0x8 / otro"]:::dp
    MUX["<b>mux + registro d_out</b><br/>carga si cs & rd"]:::dp
    U -- "rx_data[7:0], rx_valid, rx_frame_err" --> D
    U -- "rx_frame_err" --> S
    D -- "p1_*, p2_* (8+8+1+1+8 c/u)" --> J
    D -- "p1_nuevo, p2_nuevo, val_err" --> S
    J -- "joy1_data[31:0], joy2_data[31:0]" --> MUX
    S -- "status[3:0]" --> MUX
    DEC -- "sel" --> MUX
  end
  cs(["cs (1)"]):::bus --> MUX
  rd(["rd (1)"]):::bus --> MUX
  addr(["addr[3:0]"]):::bus --> DEC
  MUX --> dout(["d_out[31:0]"]):::bus
