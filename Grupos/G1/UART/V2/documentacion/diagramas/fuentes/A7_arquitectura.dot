digraph A7 {
  rankdir=LR; newrank=true; splines=spline; nodesep=0.25; ranksep=0.55;
  fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#1f5fbf"];
  edge [fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7];
  label="A7 · Arquitectura control / datapath de peripheral_mandos (rojo = control, azul = datapath, amarillo = bus del SoC)"; labelloc=t; fontsize=14;

  uart_rx [label="uart_rx", shape=oval, fillcolor="#fff4d6", color="#b26b00"];
  subgraph cluster_u { label="uart_8n1 (RX)"; color="#1f5fbf"; style=dashed;
    sync  [label="rx_sync[1:0]\n2 FF"];
    cnt   [label="r_cnt[8:0]\n←0 | ←+1"];
    ccmp  [label="r_cnt = 116 ?\nr_cnt = 233 ?", shape=diamond, fillcolor="#ffffff"];
    idx   [label="r_idx[2:0]\n←0 | ←+1"];
    icmp  [label="r_idx = 7 ?", shape=diamond, fillcolor="#ffffff"];
    sh    [label="r_sh[7:0]\n←{rx_in, r_sh[7:1]}"];
    rdat  [label="rx_data[7:0]\n←r_sh"];
    fsm1  [label="FSM RX\nIDLE · START · DATA\nSTOP · ESPERA", fillcolor="#fdecea", color="#c0392b", penwidth=2];
  }
  subgraph cluster_d { label="desempaquetador"; color="#1f5fbf"; style=dashed;
    lat   [label="latches\njug_l seq_l x_l y_l\nshield_l punch_l"];
    xr    [label="xor_l[7:0]\n←0 | ←xor_l ⊕ rx_data"];
    didx  [label="idx[2:0]\n←1 | ←+1"];
    esp   [label="espera[14:0]\n←0 | ←+1"];
    cmpd  [label="rx_data = 0xAA ?\nrx_data = xor_l ?\njug_l = 1 / 2 ?\nidx = 6 ?\nespera = T_MAX−1 ?", shape=box, style="filled", fillcolor="#ffffff"];
    p1    [label="p1_x p1_y p1_shield\np1_punch p1_seq"];
    p2    [label="p2_x p2_y p2_shield\np2_punch p2_seq"];
    fsm2  [label="FSM desempaquetador\nS_DIR · S_VAL · S_CHK", fillcolor="#fdecea", color="#c0392b", penwidth=2];
  }
  subgraph cluster_b { label="adaptador de bus (perip_mandos.v)"; color="#1f5fbf"; style=dashed;
    st    [label="STATUS[3:0]\nbanderas retenidas"];
    jw    [label="JOY1 = {p1_seq, 6'b0, p1_punch,\np1_shield, p1_y, p1_x}\nJOY2 = igual con p2_*"];
    dec   [label="decodificador\naddr[3:0]", shape=trapezium, style=filled];
    mux   [label="mux 4:1", shape=invtrapezium, style=filled];
    dout  [label="d_out[31:0]\nen = cs & rd"];
  }
  cs   [label="cs = cs[7]", shape=oval, fillcolor="#fff4d6", color="#b26b00"];
  rd   [label="rd = mem_rstrb", shape=oval, fillcolor="#fff4d6", color="#b26b00"];
  addr [label="addr[3:0]", shape=oval, fillcolor="#fff4d6", color="#b26b00"];
  out  [label="d_out → chip_select\n→ mem_rdata", shape=oval, fillcolor="#fff4d6", color="#b26b00"];

  uart_rx -> sync -> sh [label="rx_in"];
  sync -> fsm1 [label="rx_in"];
  cnt -> ccmp -> fsm1; idx -> icmp -> fsm1;
  fsm1 -> cnt [label="clr / inc", color="#c0392b", fontcolor="#c0392b"];
  fsm1 -> idx [label="clr / inc", color="#c0392b", fontcolor="#c0392b"];
  fsm1 -> sh  [label="desplazar", color="#c0392b", fontcolor="#c0392b"];
  fsm1 -> rdat [label="cargar", color="#c0392b", fontcolor="#c0392b"];
  sh -> rdat;
  fsm1 -> fsm2 [label="rx_valid\nrx_frame_err"];
  rdat -> lat; rdat -> xr; rdat -> cmpd;
  xr -> cmpd; lat -> cmpd; didx -> cmpd; esp -> cmpd;
  cmpd -> fsm2 [label="condiciones"];
  fsm2 -> lat  [label="cargar latch[idx]", color="#c0392b", fontcolor="#c0392b"];
  fsm2 -> xr   [label="clr / acumular", color="#c0392b", fontcolor="#c0392b"];
  fsm2 -> didx [label="ini / inc", color="#c0392b", fontcolor="#c0392b"];
  fsm2 -> esp  [label="clr / inc", color="#c0392b", fontcolor="#c0392b"];
  fsm2 -> p1   [label="publicar J1", color="#c0392b", fontcolor="#c0392b"];
  fsm2 -> p2   [label="publicar J2", color="#c0392b", fontcolor="#c0392b"];
  lat -> p1; lat -> p2;
  fsm2 -> st [label="p1_nuevo p2_nuevo\nval_err", color="#c0392b", fontcolor="#c0392b"];
  fsm1 -> st [label="rx_frame_err", color="#c0392b", fontcolor="#c0392b"];
  p1 -> jw; p2 -> jw;
  jw -> mux [label="JOY1, JOY2"]; st -> mux [label="STATUS"];
  addr -> dec -> mux [label="sel"];
  mux -> dout; cs -> dout; rd -> dout; dout -> out;
  {rank=same; fsm1; cnt; idx}
}
