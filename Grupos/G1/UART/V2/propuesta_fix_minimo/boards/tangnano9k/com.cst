// -----------------------------------------------------------------------------
// com.cst — Tang Nano 9K (GW1NR-LV9QN88PC6/I5) para com.v
// -----------------------------------------------------------------------------

// Reloj de 27 MHz
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Botón de reset, activo en bajo (pin 3 = S2).
// Si en tu placa el botón correcto es el otro, cambia 3 por 4.
IO_LOC  "btn_rst_n" 3;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART RX: entrada desde el TX del ESP32 (3,3 V, GND común con el ESP32).
// Pin 33 = pin libre de la regleta de la placa.
// Para probar desde el PC por el USB de la placa, usa en cambio el pin 18.
IO_LOC  "uart_rx" 33;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
//IO_LOC  "uart_rx" 18;
//IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// 6 LEDs de la placa (activos en bajo)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
