// Reloj del sistema (27 MHz en el pin 52 de la Tang Nano 9K)
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Botón S2 de la tarjeta como Reset activo en bajo
IO_LOC "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS33;

// Pin de salida UART TX (ejemplo: Pin 25 del conector J2)
IO_LOC "uart_tx" 25;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;