// Reloj del sistema (27 MHz en el pin 52)
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Botón S2 como Reset activo en bajo
IO_LOC "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS33;

// Pin de entrada RX (ejemplo: Pin 26 del conector J2)
IO_LOC "uart_rx_pin" 26;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33;