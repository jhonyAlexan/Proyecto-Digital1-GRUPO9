// ============================================================================
// Archivo: Grupos/G2/rtl/g2_flash.cst
// Tarjeta: Sipeed Tang Nano 9K (FPGA Gowin GW1NR-LV9QN88PC6/I5)
// Descripción: Restricciones físicas (IO_LOC / IO_PORT) para la interfaz
//              SPI Modo 0 del Subgrupo G2 (Memorias).
// ============================================================================

// ----------------------------------------------------------------------------
// 1. Pines físicos de la memoria Flash SPI integrada (Bus MSPI - Banco 1, 3.3V)
//    Nota: Requiere habilitar el flag --use_mspi_as_gpio en gowin_pack
//          (o "Use MSPI as regular IO" en Gowin EDA) para operar en ejecución.
// ----------------------------------------------------------------------------
IO_LOC  "spi_cs_n" 60;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "spi_sclk" 59;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "spi_mosi" 61;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "spi_miso" 62;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ----------------------------------------------------------------------------
// 2. Alternativa para módulo DIP8 Winbond W25Q64JV externo en protoboard
//    (Descomentar estas líneas y comentar la sección 1 si se conecta por
//    cables Dupont en el header lateral izquierdo de 3.3V, pines 25..28)
// ----------------------------------------------------------------------------
// IO_LOC  "spi_cs_n" 25;
// IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// IO_LOC  "spi_sclk" 26;
// IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// IO_LOC  "spi_mosi" 27;
// IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// IO_LOC  "spi_miso" 28;
// IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ----------------------------------------------------------------------------
// 3. Reloj maestro y Reset (Solo para síntesis aislada de g2_mem_top.v)
//    En la integración completa del SoC, estas restricciones ya existen en el
//    archivo .cst raíz y deben mantenerse comentadas aquí para no duplicarlas.
// ----------------------------------------------------------------------------
// IO_LOC  "clk" 52;
// IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
//
// IO_LOC  "rst" 4;
// IO_PORT "rst" IO_TYPE=LVCMOS18 PULL_MODE=UP;
