
// Reloj de 27 MHz
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Botones S1 (reset) y S2 (usuario)
IO_LOC "btn_s1" 4;
IO_PORT "btn_s1" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "btn_s2" 3;
IO_PORT "btn_s2" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// LEDs de la tarjeta (activos en bajo)
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// UART por USB (chip BL702 de la tarjeta)
IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Panel HUB75 64x64 (todos en bancos de 3,3 V). Se evitan 68-75 (HDMI),
// 59-62 (flash SPI), 25-28 (flash externa de G2), 17-18 (UART) y 52 (reloj).
// Confirmar cada número con el Pinmap de la wiki de Sipeed antes de cablear.
IO_LOC "r1" 76;
IO_PORT "r1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "g1" 77;
IO_PORT "g1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "b1" 79;
IO_PORT "b1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "r2" 80;
IO_PORT "r2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "g2" 81;
IO_PORT "g2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "b2" 82;
IO_PORT "b2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "addr_a" 83;
IO_PORT "addr_a" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "addr_b" 84;
IO_PORT "addr_b" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "addr_c" 85;
IO_PORT "addr_c" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "addr_d" 86;
IO_PORT "addr_d" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "addr_e" 29;
IO_PORT "addr_e" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "hub75_clk" 30;
IO_PORT "hub75_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "hub75_lat" 33;
IO_PORT "hub75_lat" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "hub75_oe" 34;
IO_PORT "hub75_oe" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
